# docker compose 变量文件
# 复制为 .env 并修改实际值：
#   cp .env.example .env

# 宿主映射端口（默认 3000）
APP_PORT=3000

# PostgreSQL 连接 URL
DATABASE_URL=postgresql://postgres:your-password@host.docker.internal:5432/fsdx_web

# JWT access token 密钥（务必修改为强随机字符串，至少 32 位）
JWT_SECRET=change-me-in-production-at-least-32-characters-long

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 镜像标签（可选，默认 latest）
# TAG=latest
