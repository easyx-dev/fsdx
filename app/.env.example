# docker compose 变量文件
# 复制为 .env 并修改实际值：
#   cp .env.example .env
#
# 本地开发同样复制为 .env：
#   cp .env.example .env

# 宿主映射端口（默认 3000）
APP_PORT=3000

# PostgreSQL 连接 URL（必填）
DATABASE_URL=postgresql://postgres:your-password@host.docker.internal:5432/app_web

# JWT access token 密钥（务必修改为强随机字符串，至少 32 位）
JWT_SECRET=change-me-in-production-at-least-32-characters-long

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 系统配置敏感值加密主密钥（可选，但一旦启用敏感配置即为必填）
# 32 字节的 Base64 或 64 位十六进制字符串；生成示例：
#   openssl rand -base64 32
# 注意：密钥丢失后已加密的敏感配置将无法解密恢复，请妥善备份
# CONFIG_ENCRYPTION_KEY=

# 认证 Cookie 是否启用 Secure 标志（可选）
# 未设置时生产环境默认开启（配合 HTTPS）。若线上尚未启用 HTTPS，
# 必须设为 false，否则浏览器不保存带 Secure 标志的 Cookie，登录后会被打回登录页
# COOKIE_SECURE=false

# 注意：不要在 env 文件中设置 NODE_ENV，Vite 会根据命令自动设置
# （vite dev → development，vite build → production）

# 数据存储目录（日志、上传文件等），默认 .tmp
STORAGE_DIR=.tmp

# pg 连接池最大连接数（可选，默认 10）
# DB_POOL_MAX=10
# pg 连接空闲回收时间，毫秒（可选，默认 30000）
# DB_POOL_IDLE_TIMEOUT_MS=30000
# pg 连接获取超时，毫秒（可选，默认 2000）
# DB_POOL_CONNECTION_TIMEOUT_MS=2000

# 镜像标签（可选，默认 latest）
# TAG=latest
