 # PostgreSQL 连接 URL（必填）
 DATABASE_URL="postgresql://postgres:123456@localhost:5432/fsdx_cms_tan"
 
# JWT access token 密钥（生产环境务必修改）
# JWT_SECRET=change-me-in-production
 
# 日志级别：fatal | error | warn | info | debug | trace
 # LOG_LEVEL=info
 
 # 运行环境：development | production | test
 # NODE_ENV=development
 
 # 数据存储目录（日志、上传文件等），默认 .tmp
 # STORAGE_DIR=.tmp
 
 # SMTP 邮件配置（可选，发送验证码等邮件时需设置）
 # SMTP_HOST=smtp.example.com
 # SMTP_PORT=587
 # SMTP_SECURE=false
 # SMTP_USER=
 # SMTP_PASS=
 # SMTP_FROM=noreply@example.com
